model Inspection {
  id          String           @id @default(cuid())
  projectId   String
  permitId    String?
  type        String
  scheduledAt DateTime?
  result      InspectionResult @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  permit  Permit? @relation(fields: [permitId], references: [id])

  @@index([projectId])
  @@map("inspections")
}

model JobPosting {
  id           String        @id @default(cuid())
  projectId    String
  scope        JobScope
  county       String
  budgetCents  Int?
  windowStart  DateTime
  windowEnd    DateTime
  bidsCloseAt  DateTime
  status       PostingStatus @default(OPEN)
  awardedBidId String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  project    Project    @relation(fields: [projectId], references: [id])
  bids       Bid[]      @relation("PostingBids")
  awardedBid Bid?       @relation("AwardedBid", fields: [awardedBidId], references: [id])
  workOrder  WorkOrder?

  @@index([status])
  @@index([county])
  @@map("job_postings")
}

model Bid {
  id            String    @id @default(cuid())
  jobPostingId  String
  contractorId  String // legacy installer pointer (Contractor→installers)
  amountCents   Int
  proposedStart DateTime
  note          String?
  status        BidStatus @default(SUBMITTED)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  jobPosting JobPosting  @relation("PostingBids", fields: [jobPostingId], references: [id])
  awardedFor JobPosting? @relation("AwardedBid")

  @@index([jobPostingId])
  @@map("bids")
}

model Task {
  id         String     @id @default(cuid())
  projectId  String?
  leadId     String?
  assigneeId String? // NON-ADDITIVE: relaxed nullable; FK to platform_users dropped
  title      String
  dueAt      DateTime?
  status     TaskStatus @default(OPEN)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  project Project?   @relation(fields: [projectId], references: [id])
  lead    SalesLead? @relation(fields: [leadId], references: [id])

  @@index([projectId])
  @@map("tasks")
}

model MonitoringSite {
  id             String    @id @default(cuid())
  projectId      String    @unique
  provider       String
  providerSiteId String
  commissionedAt DateTime?
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project   Project             @relation(fields: [projectId], references: [id])
  telemetry TelemetrySnapshot[]

  @@map("monitoring_sites")
}

model TelemetrySnapshot {
  id               BigInt   @id @default(autoincrement())
  monitoringSiteId String
  ts               DateTime
  soc              Float
  powerKw          Float
  mode             String
  gridConnected    Boolean  @default(true)

  monitoringSite MonitoringSite @relation(fields: [monitoringSiteId], references: [id])

  @@index([monitoringSiteId, ts])
  @@map("telemetry_snapshots")
}
