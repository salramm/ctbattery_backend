}

/// FROZEN. Backfill source (unconverted leads → systems at S01/S02).
model SalesLead {
  id                   String     @id @default(cuid())
  addressId            String
  contactId            String
  ownerId              String? // legacy staff pointer (FK dropped in re-model)
  source               LeadSource
  status               LeadStatus @default(NEW)
  disqualifyReason     String?
  estimatedMonthlyBill Decimal?
  convertedCustomerId  String?    @unique
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  address  Property  @relation("LeadAddress", fields: [addressId], references: [id])
  contact  Contact   @relation(fields: [contactId], references: [id])
  customer Customer? @relation("LeadCustomer")
  tasks    Task[]

  @@index([status])
  @@map("sales_leads")
}

/// FROZEN. Backfill source (converted → Project → system).
model Customer {
  id               String         @id @default(cuid())
  leadId           String         @unique
  contactId        String
  serviceAddressId String
  billingAddressId String?
  status           CustomerStatus @default(LOI_SENT)
  creditTier       String?
  creditCheckedAt  DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  lead           SalesLead @relation("LeadCustomer", fields: [leadId], references: [id])
  contact        Contact   @relation(fields: [contactId], references: [id])
  serviceAddress Property  @relation("CustServiceAddr", fields: [serviceAddressId], references: [id])
  billingAddress Property? @relation("CustBillingAddr", fields: [billingAddressId], references: [id])
  project        Project?

  @@map("customers")
}

/// FROZEN. Primary backfill source — each Project → one `systems` row.
model Project {
  id               String       @id @default(cuid())
  customerId       String       @unique
  siteAddressId    String
  stage            ProjectStage @default(DESIGN)
  health           HealthState  @default(OK)
  projectManagerId String? // legacy staff pointer (FK dropped in re-model)
  termYears        Int          @default(20)
  monthlyRateCents Int
  targetPtoDate    DateTime?
  actualPtoDate    DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id])
  siteAddress     Property         @relation("ProjSiteAddr", fields: [siteAddressId], references: [id])
  designs         SystemDesign[]
  survey          SiteSurvey?
  permits         Permit[]
  interconnection Interconnection?
  inspections     Inspection[]
  jobPostings     JobPosting[]
  monitoringSite  MonitoringSite?
  tasks           Task[]

  @@index([stage])
  @@index([health])
  @@map("projects")
}

