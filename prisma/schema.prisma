// CT Battery Solutions — data model.
// Conventions: PascalCase models, snake_case columns via @map, enums @@map'd,
// createdAt/updatedAt everywhere, indexes on every where/orderBy column.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==== ENUMS ===================================================================

enum UserRole {
  ADMIN
  OWNER

  @@map("user_role")
}

enum EligibilityKind {
  STANDARD
  PRIORITY
  INELIGIBLE

  @@map("eligibility_kind")
}

enum ApplicationStatus {
  LEAD
  SUBMITTED
  RENTER_PENDING
  SURVEY_SCHEDULED
  SIGNED

  @@map("application_status")
}

enum OwnerOutreachMode {
  WE
  SELF

  @@map("owner_outreach_mode")
}

// ==== MODELS ==================================================================

/// Admin portal users. Identity verified by Firebase; the API issues its own JWT.
model User {
  id          Int      @id @default(autoincrement())
  firebaseUid String   @unique @map("firebase_uid") @db.VarChar(128)
  email       String   @unique @db.VarChar(255)
  name        String?  @db.VarChar(255)
  role        UserRole @default(ADMIN)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// A consumer battery application (the /ct/apply flow). Single table with grouped
/// nullable sections; free-text selections stored as strings, branch fields as enums.
model Application {
  id                Int               @id @default(autoincrement())
  applicationNumber String            @unique @map("application_number") @db.VarChar(32)
  status            ApplicationStatus @default(SUBMITTED)
  source            String?           @db.VarChar(64)

  // Contact
  firstName         String  @map("first_name") @db.VarChar(120)
  lastName          String  @map("last_name") @db.VarChar(120)
  email             String  @db.VarChar(255)
  phone             String  @db.VarChar(40)
  preferredLanguage String? @map("preferred_language") @db.VarChar(60)

  // Property
  formattedAddress    String  @map("formatted_address") @db.VarChar(400)
  lat                 Float?
  lng                 Float?
  city                String? @db.VarChar(120)
  utility             String? @db.VarChar(160)
  dwellingType        String? @map("dwelling_type") @db.VarChar(80)
  isOwner             Boolean @default(true) @map("is_owner")
  utilityAccount      String? @map("utility_account") @db.VarChar(60)
  hasMedicalEquipment Boolean @default(false) @map("has_medical_equipment")

  // Eligibility snapshot (as resolved at submit time)
  eligibilityKind EligibilityKind? @map("eligibility_kind")
  resolvedUtility String?          @map("resolved_utility") @db.VarChar(160)
  resolvedCity    String?          @map("resolved_city") @db.VarChar(120)

  // Install details (owner path)
  installLocation String? @map("install_location") @db.VarChar(80)
  panelAmps       String? @map("panel_amps") @db.VarChar(80)
  panelAge        String? @map("panel_age") @db.VarChar(80)
  solarStatus     String? @map("solar_status") @db.VarChar(120)
  accessNotes     String? @map("access_notes") @db.VarChar(1000)

  // Renter path (owner outreach)
  ownerName            String?            @map("owner_name") @db.VarChar(200)
  ownerOrg             String?            @map("owner_org") @db.VarChar(200)
  ownerEmail           String?            @map("owner_email") @db.VarChar(255)
  ownerPhone           String?            @map("owner_phone") @db.VarChar(40)
  ownerOutreachMode    OwnerOutreachMode? @map("owner_outreach_mode")
  ownerNote            String?            @map("owner_note") @db.VarChar(1000)
  renterPendingConsent Boolean            @default(false) @map("renter_pending_consent")

  // Survey scheduling
  surveyDate String? @map("survey_date") @db.VarChar(40)
  surveySlot String? @map("survey_slot") @db.VarChar(40)

  // Consent / ESA e-signature
  agreeReadEsa    Boolean   @default(false) @map("agree_read_esa")
  agreeAuthEnroll Boolean   @default(false) @map("agree_auth_enroll")
  agreeESign      Boolean   @default(false) @map("agree_esign")
  signedName      String?   @map("signed_name") @db.VarChar(200)
  signedAt        DateTime? @map("signed_at")
  esaVersion      String?   @map("esa_version") @db.VarChar(40)

  // Uploaded electrical-panel photo (DO Spaces CDN URL)
  panelPhotoUrl String? @map("panel_photo_url") @db.VarChar(600)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("applications")
}

/// OpenEI USURDB commercial & industrial rate tariffs (~41.8k rows). Nested rate
/// structures kept as JSON; queryable columns are indexed.
model RateTariff {
  id          Int      @id @default(autoincrement())
  label       String   @unique @db.VarChar(64)
  // Uncontrolled USURDB text — kept unbounded to avoid P2000 on long values.
  utilityName String   @map("utility_name")
  eiaId       String?  @map("eia_id") @db.VarChar(32)
  rateName    String?  @map("rate_name")
  sector      String?  @db.VarChar(64)
  serviceType String?  @map("service_type")
  description String?
  sourceUrl   String?  @map("source_url")
  isDefault   Boolean? @map("is_default")
  approved    Boolean?
  startDate   String?  @map("start_date") @db.VarChar(40)
  endDate     String?  @map("end_date") @db.VarChar(40)

  // Demand charges
  flatDemandUnit          String?  @map("flat_demand_unit") @db.VarChar(40)
  flatDemandStructure     Json?    @map("flat_demand_structure")
  flatDemandMonths        Json?    @map("flat_demand_months")
  demandRateUnit          String?  @map("demand_rate_unit") @db.VarChar(40)
  demandRateStructure     Json?    @map("demand_rate_structure")
  demandWeekdaySchedule   Json?    @map("demand_weekday_schedule")
  demandWeekendSchedule   Json?    @map("demand_weekend_schedule")
  demandRatchetPercentage Float?   @map("demand_ratchet_percentage")
  demandWindow            Int?     @map("demand_window")
  demandReactivePowerCharge Float? @map("demand_reactive_power_charge")

  // Coincident peak
  coincidentRateUnit      String?  @map("coincident_rate_unit") @db.VarChar(40)
  coincidentRateStructure Json?    @map("coincident_rate_structure")
  coincidentSchedule      Json?    @map("coincident_schedule")

  // Energy charges
  energyRateUnit        String? @map("energy_rate_unit") @db.VarChar(40)
  energyRateStructure   Json?   @map("energy_rate_structure")
  energyWeekdaySchedule Json?   @map("energy_weekday_schedule")
  energyWeekendSchedule Json?   @map("energy_weekend_schedule")

  // Fixed charges
  fixedMonthlyCharge Float? @map("fixed_monthly_charge")
  minMonthlyCharge   Float? @map("min_monthly_charge")
  annualMinCharge    Float? @map("annual_min_charge")

  // Capacity
  peakKwCapacityMin Float?   @map("peak_kw_capacity_min")
  peakKwCapacityMax Float?   @map("peak_kw_capacity_max")
  usesNetMetering   Boolean? @map("uses_net_metering")

  rawJson   Json?    @map("raw_json")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([utilityName])
  @@index([eiaId])
  @@index([sector])
  @@map("rate_tariffs")
}

/// Proprietary market enrichment for target utility territories (DR revenue,
/// incentives, C-PACE, interconnection, BESS score). Small, curated table.
model UtilityEnrichment {
  id          Int     @id @default(autoincrement())
  utilityName String  @map("utility_name") @db.VarChar(255)
  state       String  @db.VarChar(8)
  isoRto      String? @map("iso_rto") @db.VarChar(40)

  // Demand response
  drProgramName      String? @map("dr_program_name") @db.VarChar(200)
  drProgramType      String? @map("dr_program_type") @db.VarChar(120)
  drRevenuePerKwYear Float?  @map("dr_revenue_per_kw_year")
  drSeasonStart      String? @map("dr_season_start") @db.VarChar(40)
  drSeasonEnd        String? @map("dr_season_end") @db.VarChar(40)
  drEventsPerYear    Int?    @map("dr_events_per_year")
  drEnrollmentMethod String? @map("dr_enrollment_method") @db.VarChar(200)

  // Incentives
  incentiveProgram      String? @map("incentive_program") @db.VarChar(200)
  incentiveRatePerKwh   Float?  @map("incentive_rate_per_kwh")
  incentiveBlockName    String? @map("incentive_block_name") @db.VarChar(120)
  incentiveRemainingMwh Float?  @map("incentive_remaining_mwh")
  incentiveUrl          String? @map("incentive_url") @db.VarChar(600)

  // C-PACE financing
  cpaceAvailable            Boolean? @map("cpace_available")
  cpaceAdministrator        String?  @map("cpace_administrator") @db.VarChar(200)
  cpaceAdministratorContact String?  @map("cpace_administrator_contact") @db.VarChar(200)
  cpaceCountiesOptedIn      String?  @map("cpace_counties_opted_in") @db.VarChar(600)

  // Interconnection / permitting
  interconnectionProcess       String?  @map("interconnection_process") @db.VarChar(300)
  interconnectionTimelineWeeks Int?     @map("interconnection_timeline_weeks")
  greenButtonCmdAvailable      Boolean? @map("green_button_cmd_available")
  avgPermitTimelineWeeks       Int?     @map("avg_permit_timeline_weeks")
  fireReviewRequired           Boolean? @map("fire_review_required")

  // Analysis
  specialRequirements  String?
  bessScore            Int?    @map("bess_score")
  primaryRevenueDriver String? @map("primary_revenue_driver") @db.VarChar(60)
  notes                String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([utilityName, state])
  @@index([utilityName])
  @@index([state])
  @@map("utility_enrichment")
}

/// Waitlist "Join the list" signups from the pre-approval landing. Lightweight
/// lead capture (email required); upserted on email so re-submits don't dupe.
model Lead {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(255)
  firstName String?  @map("first_name") @db.VarChar(120)
  lastName  String?  @map("last_name") @db.VarChar(120)
  cityOrZip String?  @map("city_or_zip") @db.VarChar(120)
  phone     String?  @db.VarChar(40)
  tenure    String?  @db.VarChar(40)
  utility   String?  @db.VarChar(80)
  source    String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("leads")
}

/// Non-binding Letter of Intent signed on the site. Captures the site owner's
/// interest + a typed e-signature; the PDF is generated on demand from this data.
model Loi {
  id              Int      @id @default(autoincrement())
  loiNumber       String   @unique @map("loi_number") @db.VarChar(32)
  // Site owner
  siteOwnerName   String   @map("site_owner_name") @db.VarChar(200)
  propertyAddress String   @map("property_address") @db.VarChar(400)
  email           String   @db.VarChar(255)
  phone           String?  @db.VarChar(40)
  // Proposed project
  batteryCount    String?  @map("battery_count") @db.VarChar(20) // one | two | three_plus
  rooftopSolar    String?  @map("rooftop_solar") @db.VarChar(20) // yes | no | planned
  timeframe       String?  @db.VarChar(20)                       // asap | flexible
  reasons         String[] @default([])                          // multi-select
  reasonOther     String?  @map("reason_other") @db.VarChar(300)
  // E-signature
  signedName      String   @map("signed_name") @db.VarChar(200)
  signedAt        DateTime @default(now()) @map("signed_at")
  signatureIp     String?  @map("signature_ip") @db.VarChar(64)
  source          String?  @db.VarChar(64)
  // ESS/ITC qualification snapshot (computed from propertyAddress at signing)
  essTier         String?  @map("ess_tier") @db.VarChar(20) // BASE | UNDERSERVED
  underserved     Boolean?
  energyCommunity Boolean? @map("energy_community")
  nmtcLowIncome   Boolean? @map("nmtc_low_income")
  itcConfirmedPct Int?     @map("itc_confirmed_pct")
  itcPotentialPct Int?     @map("itc_potential_pct")
  lucrativeScore  Int?     @map("lucrative_score") // higher = prioritize
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([createdAt])
  @@index([lucrativeScore])
  @@map("lois")
}

// Connecticut multifamily affordable-housing master list (LIHTC + Section 8 /
// HUD multifamily + public housing). Drives MFAH auto-qualification for the ESS
// Low-Income tier and the ITC §48(e) Cat 3 adder. Loaded from
// data/ess/CT_MFAH_Master_List.csv and geocoded via Census (see import-mfah.ts).
model MfahProperty {
  id                  Int      @id @default(autoincrement())
  projectName         String?  @map("project_name")
  address             String
  city                String
  zip                 String?
  units               Int?
  sources             String[] @default([]) // LIHTC | Section8_Multifamily | Public_Housing
  ownerOperator       String?  @map("owner_operator")
  contactEmail        String?  @map("contact_email")
  multiProgramOverlap Boolean  @default(false) @map("multi_program_overlap")
  lat                 Float?
  lng                 Float?
  censusTractFips     String?  @map("census_tract_fips")
  normAddress         String   @map("norm_address") // normalized "address|city" for matching
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([normAddress])
  @@index([city])
  @@map("mfah_properties")
}

// =============================================================================
// TPO OPERATIONS PLATFORM  (dashboard behind /portal)
// Implements the "TPO Platform Model" spec: 26 models across 7 domains, verbatim
// field names. NOTE: the spec's `Lead` and `User` are renamed here to `SalesLead`
// and `PlatformUser` to avoid colliding with the existing waitlist `Lead` and
// admin `User` models above. All rows are currently seeded demo data.
// =============================================================================

// ==== TPO ENUMS ====
enum LeadSource {
  WEB
  REFERRAL
  PARTNER
  CANVASS
  UTILITY_LIST
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
}

enum CustomerStatus {
  LOI_SENT
  LOI_SIGNED
  CREDIT_APPROVED
  AGREEMENT_SIGNED
}

enum DocType {
  LOI
  TPO_AGREEMENT
  NTP
  PERMIT_SET
  PHOTO
  INSPECTION_REPORT
  COI
}

enum DocStatus {
  DRAFT
  SENT
  SIGNED
  VOID
}

enum ProjectStage {
  DESIGN
  SITE_SURVEY
  PERMITTING
  INTERCONNECTION
  SCHEDULED
  INSTALLED
  INSPECTION
  PTO
  MONITORING
  ACTIVE
}

enum Health {
  ON_TRACK
  AT_RISK
  BLOCKED
}

enum AssetStatus {
  IN_STOCK
  ALLOCATED
  INSTALLED
  RMA
  RETIRED
}

enum SurveyStatus {
  SCHEDULED
  COMPLETE
  FAILED
}

enum PermitType {
  ELECTRICAL
  BUILDING
  FIRE
}

enum PermitStatus {
  NOT_STARTED
  SUBMITTED
  CORRECTIONS
  APPROVED
  EXPIRED
}

enum IxStatus {
  NOT_STARTED
  SUBMITTED
  IN_REVIEW
  APPROVED_TO_INSTALL
  PTO_GRANTED
  REJECTED
}

enum InspectionResult {
  PENDING
  PASS
  FAIL
}

enum ContractorStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ContractorRole {
  ADMIN
  TECH
}

enum JobScope {
  SITE_SURVEY
  INSTALL
  SERVICE
  REMOVAL
}

enum PostingStatus {
  OPEN
  AWARDED
  CANCELLED
  EXPIRED
}

enum BidStatus {
  SUBMITTED
  WITHDRAWN
  WON
  LOST
}

enum WorkOrderStatus {
  AWARDED
  SCHEDULED
  IN_PROGRESS
  SUBMITTED
  ACCEPTED
  REWORK
  CANCELLED
}

enum Severity {
  INFO
  WARN
  CRITICAL
}

enum SubjectType {
  LEAD
  CUSTOMER
  PROJECT
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum PlatformRole {
  SALES_REP
  SALES_MANAGER
  OPS
  ADMIN
  CONTRACTOR
  HOMEOWNER
}

// ==== PLATFORM domain ====
model PlatformUser {
  id        String       @id @default(cuid())
  email     String       @unique
  name      String
  role      PlatformRole
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  contact          Contact?          @relation("UserContact")
  ownedLeads       SalesLead[]       @relation("LeadOwner")
  managedProjects  Project[]         @relation("ProjectPM")
  assignedTasks    Task[]
  stageTransitions StageTransition[]
  contractorLinks  ContractorUser[]

  @@map("platform_users")
}

model StageTransition {
  id          String        @id @default(cuid())
  subjectType SubjectType
  subjectId   String
  fromStage   String
  toStage     String
  actorId     String?
  occurredAt  DateTime      @default(now())
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  actor PlatformUser? @relation(fields: [actorId], references: [id])

  @@index([subjectType, subjectId])
  @@map("stage_transitions")
}

model Task {
  id         String     @id @default(cuid())
  projectId  String?
  leadId     String?
  assigneeId String
  title      String
  dueAt      DateTime?
  status     TaskStatus @default(OPEN)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  project  Project?     @relation(fields: [projectId], references: [id])
  lead     SalesLead?   @relation(fields: [leadId], references: [id])
  assignee PlatformUser @relation(fields: [assigneeId], references: [id])

  @@index([projectId])
  @@map("tasks")
}

model Document {
  id             String    @id @default(cuid())
  customerId     String?
  projectId      String?
  type           DocType
  status         DocStatus @default(DRAFT)
  esignEnvelopeId String?
  signedAt       DateTime?
  fileUrl        String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])
  project  Project?  @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@map("documents")
}

// ==== PLACE domain ====
model Utility {
  id                       String   @id @default(cuid())
  name                     String
  territoryCode            String
  interconnectionPortalUrl String?
  standardReviewDays       Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  addresses        Address[]
  interconnections Interconnection[]

  @@map("utilities")
}

model Ahj {
  id                String   @id @default(cuid())
  name              String
  county            String
  permitPortalUrl   String?
  avgApprovalDays   Int?
  requiresStructural Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  addresses Address[]
  permits   Permit[]

  @@map("ahjs")
}

model Address {
  id         String   @id @default(cuid())
  line1      String
  line2      String?
  city       String
  state      String   @default("CT")
  postalCode String
  county     String
  lat        Float?
  lng        Float?
  utilityId  String?
  ahjId      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  utility          Utility?   @relation(fields: [utilityId], references: [id])
  ahj              Ahj?       @relation(fields: [ahjId], references: [id])
  leads            SalesLead[] @relation("LeadAddress")
  serviceCustomers Customer[]  @relation("CustServiceAddr")
  billingCustomers Customer[]  @relation("CustBillingAddr")
  projects         Project[]   @relation("ProjSiteAddr")

  @@index([county])
  @@map("addresses")
}

// ==== DEMAND domain ====
model Contact {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  email             String   @unique
  phone             String
  preferredLanguage String   @default("en")
  userId            String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user      PlatformUser? @relation("UserContact", fields: [userId], references: [id])
  leads     SalesLead[]
  customers Customer[]

  @@map("contacts")
}

model SalesLead {
  id                   String     @id @default(cuid())
  addressId            String
  contactId            String
  ownerId              String?
  source               LeadSource
  status               LeadStatus @default(NEW)
  disqualifyReason     String?
  estimatedMonthlyBill Decimal?
  convertedCustomerId  String?    @unique
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  address  Address       @relation("LeadAddress", fields: [addressId], references: [id])
  contact  Contact       @relation(fields: [contactId], references: [id])
  owner    PlatformUser? @relation("LeadOwner", fields: [ownerId], references: [id])
  customer Customer?     @relation("LeadCustomer")
  tasks    Task[]

  @@index([status])
  @@map("sales_leads")
}

model Customer {
  id               String         @id @default(cuid())
  leadId           String         @unique
  contactId        String
  serviceAddressId String
  billingAddressId String?
  status           CustomerStatus @default(LOI_SENT)
  creditTier       String?
  creditCheckedAt  DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  lead           SalesLead  @relation("LeadCustomer", fields: [leadId], references: [id])
  contact        Contact    @relation(fields: [contactId], references: [id])
  serviceAddress Address    @relation("CustServiceAddr", fields: [serviceAddressId], references: [id])
  billingAddress Address?   @relation("CustBillingAddr", fields: [billingAddressId], references: [id])
  project        Project?
  documents      Document[]

  @@map("customers")
}

// ==== DELIVERY domain ====
model Project {
  id               String       @id @default(cuid())
  customerId       String       @unique
  siteAddressId    String
  stage            ProjectStage @default(DESIGN)
  health           Health       @default(ON_TRACK)
  projectManagerId String?
  termYears        Int          @default(20)
  monthlyRateCents Int
  targetPtoDate    DateTime?
  actualPtoDate    DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  customer        Customer        @relation(fields: [customerId], references: [id])
  siteAddress     Address         @relation("ProjSiteAddr", fields: [siteAddressId], references: [id])
  projectManager  PlatformUser?   @relation("ProjectPM", fields: [projectManagerId], references: [id])
  designs         SystemDesign[]
  assets          BatteryAsset[]
  survey          SiteSurvey?
  permits         Permit[]
  interconnection Interconnection?
  inspections     Inspection[]
  jobPostings     JobPosting[]
  workOrders      WorkOrder[]
  monitoringSite  MonitoringSite?
  alerts          Alert[]
  tasks           Task[]
  documents       Document[]

  @@index([stage])
  @@index([health])
  @@map("projects")
}

model BatteryModel {
  id           String   @id @default(cuid())
  manufacturer String
  model        String
  nameplateKwh Decimal
  continuousKw Decimal
  chemistry    String
  warrantyYears Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  designs SystemDesign[]
  assets  BatteryAsset[]

  @@map("battery_models")
}

model SystemDesign {
  id            String   @id @default(cuid())
  projectId     String
  version       Int
  batteryModelId String
  quantity      Int
  usableKwh     Decimal
  continuousKw  Decimal
  inverterModel String
  solarCoupled  Boolean  @default(false)
  backupLoads   Json?
  isCurrent     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project      Project      @relation(fields: [projectId], references: [id])
  batteryModel BatteryModel @relation(fields: [batteryModelId], references: [id])

  @@index([projectId])
  @@map("system_designs")
}

model BatteryAsset {
  id            String      @id @default(cuid())
  batteryModelId String
  projectId     String?
  serialNumber  String      @unique
  status        AssetStatus @default(IN_STOCK)
  installedAt   DateTime?
  warrantyEndsAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  batteryModel BatteryModel @relation(fields: [batteryModelId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])

  @@index([status])
  @@map("battery_assets")
}

model SiteSurvey {
  id           String       @id @default(cuid())
  projectId    String       @unique
  workOrderId  String?      @unique
  scheduledAt  DateTime?
  completedAt  DateTime?
  status       SurveyStatus @default(SCHEDULED)
  mainPanelAmps Int?
  findings     Json?
  photoDocIds  String[]     @default([])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  project   Project    @relation(fields: [projectId], references: [id])
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@map("site_surveys")
}

// ==== COMPLIANCE domain ====
model Permit {
  id          String       @id @default(cuid())
  projectId   String
  ahjId       String
  type        PermitType
  number      String?
  status      PermitStatus @default(NOT_STARTED)
  submittedAt DateTime?
  approvedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project      @relation(fields: [projectId], references: [id])
  ahj         Ahj          @relation(fields: [ahjId], references: [id])
  inspections Inspection[]

  @@index([projectId])
  @@map("permits")
}

model Interconnection {
  id               String   @id @default(cuid())
  projectId        String   @unique
  utilityId        String
  applicationNumber String?
  status           IxStatus @default(NOT_STARTED)
  submittedAt      DateTime?
  approvedAt       DateTime?
  ptoAt            DateTime?
  programEnrollment String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  utility Utility @relation(fields: [utilityId], references: [id])

  @@map("interconnections")
}

model Inspection {
  id          String           @id @default(cuid())
  projectId   String
  permitId    String?
  type        String
  scheduledAt DateTime?
  result      InspectionResult @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  permit  Permit? @relation(fields: [permitId], references: [id])

  @@index([projectId])
  @@map("inspections")
}

// ==== FIELD domain ====
model Contractor {
  id                 String           @id @default(cuid())
  companyName        String
  licenseNumber      String
  licenseExpiresAt   DateTime
  insuranceExpiresAt DateTime
  serviceCounties    String[]         @default([])
  certifications     String[]         @default([])
  rating             Float?
  status             ContractorStatus @default(PENDING)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  bids            Bid[]
  workOrders      WorkOrder[]
  contractorUsers ContractorUser[]

  @@map("contractors")
}

model ContractorUser {
  id           String         @id @default(cuid())
  contractorId String
  userId       String
  role         ContractorRole @default(TECH)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  contractor Contractor   @relation(fields: [contractorId], references: [id])
  user       PlatformUser @relation(fields: [userId], references: [id])

  @@unique([contractorId, userId])
  @@map("contractor_users")
}

model JobPosting {
  id           String        @id @default(cuid())
  projectId    String
  scope        JobScope
  county       String
  budgetCents  Int?
  windowStart  DateTime
  windowEnd    DateTime
  bidsCloseAt  DateTime
  status       PostingStatus @default(OPEN)
  awardedBidId String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  project    Project    @relation(fields: [projectId], references: [id])
  bids       Bid[]      @relation("PostingBids")
  awardedBid Bid?       @relation("AwardedBid", fields: [awardedBidId], references: [id])
  workOrder  WorkOrder?

  @@index([status])
  @@index([county])
  @@map("job_postings")
}

model Bid {
  id           String    @id @default(cuid())
  jobPostingId String
  contractorId String
  amountCents  Int
  proposedStart DateTime
  note         String?
  status       BidStatus @default(SUBMITTED)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  jobPosting JobPosting  @relation("PostingBids", fields: [jobPostingId], references: [id])
  contractor Contractor  @relation(fields: [contractorId], references: [id])
  awardedFor JobPosting? @relation("AwardedBid")

  @@unique([jobPostingId, contractorId])
  @@map("bids")
}

model WorkOrder {
  id           String          @id @default(cuid())
  jobPostingId String          @unique
  projectId    String
  contractorId String
  scope        JobScope
  status       WorkOrderStatus @default(AWARDED)
  scheduledAt  DateTime?
  completedAt  DateTime?
  checklist    Json?
  qualityScore Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  jobPosting JobPosting  @relation(fields: [jobPostingId], references: [id])
  project    Project     @relation(fields: [projectId], references: [id])
  contractor Contractor  @relation(fields: [contractorId], references: [id])
  survey     SiteSurvey?
  alerts     Alert[]

  @@index([projectId])
  @@map("work_orders")
}

// ==== FLEET domain ====
model MonitoringSite {
  id             String    @id @default(cuid())
  projectId      String    @unique
  provider       String
  providerSiteId String
  commissionedAt DateTime?
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project   Project             @relation(fields: [projectId], references: [id])
  telemetry TelemetrySnapshot[]
  alerts    Alert[]

  @@map("monitoring_sites")
}

model TelemetrySnapshot {
  id               BigInt   @id @default(autoincrement())
  monitoringSiteId String
  ts               DateTime
  soc              Float
  powerKw          Float
  mode             String
  gridConnected    Boolean  @default(true)

  monitoringSite MonitoringSite @relation(fields: [monitoringSiteId], references: [id])

  @@index([monitoringSiteId, ts])
  @@map("telemetry_snapshots")
}

model Alert {
  id               String    @id @default(cuid())
  monitoringSiteId String
  projectId        String
  code             String
  message          String
  severity         Severity  @default(INFO)
  openedAt         DateTime  @default(now())
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  workOrderId      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  monitoringSite MonitoringSite @relation(fields: [monitoringSiteId], references: [id])
  project        Project        @relation(fields: [projectId], references: [id])
  workOrder      WorkOrder?     @relation(fields: [workOrderId], references: [id])

  @@index([severity])
  @@index([projectId])
  @@map("alerts")
}
