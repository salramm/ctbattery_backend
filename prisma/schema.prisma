// =============================================================================
// FROZEN SPINE + BACKFILL SOURCES + RETAINED REFERENCE (TPO platform)
// No application code writes to the frozen spine (SalesLead/Customer/Project);
// retained only as a backfill source and for the P1 count invariant.
// =============================================================================

// ==== TPO enums retained on retained tables ====
enum LeadSource {
  WEB
  REFERRAL
  PARTNER
  CANVASS
  UTILITY_LIST
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
}

enum CustomerStatus {
  LOI_SENT
  LOI_SIGNED
  CREDIT_APPROVED
  AGREEMENT_SIGNED
}

enum ProjectStage {
  DESIGN
  SITE_SURVEY
  PERMITTING
  INTERCONNECTION
  SCHEDULED
  INSTALLED
  INSPECTION
  PTO
  MONITORING
  ACTIVE
}

enum SurveyStatus {
  SCHEDULED
  COMPLETE
  FAILED
}

enum PermitType {
  ELECTRICAL
  BUILDING
  FIRE
}

enum PermitStatus {
  NOT_STARTED
  SUBMITTED
  CORRECTIONS
  APPROVED
  EXPIRED
}

enum IxStatus {
  NOT_STARTED
  SUBMITTED
  IN_REVIEW
  APPROVED_TO_INSTALL
  PTO_GRANTED
  REJECTED
}

enum InspectionResult {
  PENDING
  PASS
  FAIL
}

enum JobScope {
  SITE_SURVEY
  INSTALL
  SERVICE
  REMOVAL
}

enum PostingStatus {
  OPEN
  AWARDED
  CANCELLED
  EXPIRED
}

enum BidStatus {
  SUBMITTED
  WITHDRAWN
  WON
  LOST
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

