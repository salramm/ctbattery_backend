// CT Battery Solutions — data model.
// Conventions: PascalCase models, snake_case columns via @map, enums @@map'd,
// createdAt/updatedAt everywhere, indexes on every where/orderBy column.
//
// LIFECYCLE RE-MODEL (P1). `systems` is the sun; everything orbits it. The former
// four-table conversion spine (SalesLead → Customer → Project → BatteryAsset) is
// FROZEN — retained as a backfill source and for reference, but no application code
// writes to it (see docs/lifecycle/ + ROLLOUT-NOTES.md). Tables marked "migrated in
// place" were reshaped by the data-foundation migration, never copied in parallel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==== CONSUMER / REFERENCE ENUMS (retained) ==================================

enum EligibilityKind {
  STANDARD
  PRIORITY
  INELIGIBLE

  @@map("eligibility_kind")
}

enum ApplicationStatus {
  LEAD
  SUBMITTED
  RENTER_PENDING
  SURVEY_SCHEDULED
  SIGNED

  @@map("application_status")
}

enum OwnerOutreachMode {
  WE
  SELF

  @@map("owner_outreach_mode")
}

// ==== LIFECYCLE ENUMS (01 §Enums) ============================================

enum Stage {
  S01_LEAD
  S02_QUALIFIED
  S03_COMMITTED
  S04_APPLIED
  S05_ENTITLED
  S06_SCHEDULED
  S07_INSTALLED
  S08_COMMISSIONED
  S09_LIVE
  OPERATING

  @@map("stage")
}

enum TerminalState {
  DISQUALIFIED
  WITHDRAWN
  EXPIRED
  REMOVED
  TERM_COMPLETE

  @@map("terminal_state")
}

// NON-ADDITIVE: value replacement of the former Health enum (ON_TRACK/AT_RISK/BLOCKED).
enum HealthState {
  OK
  WATCH
  FAULT
  SERVICE

  @@map("health")
}

enum Flag {
  TURNOVER
  WARRANTY

  @@map("flag")
}

enum Tier {
  LI
  UNDERSERVED
  STANDARD

  @@map("tier")
}

enum Connection {
  M1
  M2
  M3
  M4
  M5

  @@map("connection")
}

enum AccountType {
  HA
  OWNER
  CAA
  CBO
  INDIVIDUAL

  @@map("account_type")
}

enum DealState {
  D1_TARGET
  D2_ENGAGED
  D3_PRESENTED
  D4_PILOT
  D5_MASTER
  D6_RELEASING
  D7_EXPANSION

  @@map("deal_state")
}

enum ChecklistState {
  OPEN
  NA
  DONE

  @@map("checklist_state")
}

enum HistoryVia {
  AUTO
  MANUAL
  OVERRIDE

  @@map("history_via")
}

// NON-ADDITIVE: widened from the former DocType (LOI/TPO_AGREEMENT/NTP/PERMIT_SET/…).
enum DocumentType {
  ESA
  TC
  PAYEE_DESIGNATION
  MASTER_AGMT
  PERMIT
  IX_APPROVAL
  SELF_INSPECTION
  ROF_LETTER
  COF_LETTER
  APPENDIX_E
  ATTESTATION
  PHOTO
  STATEMENT
  OTHER

  @@map("doc_type")
}

enum DocStatus {
  DRAFT
  SENT
  SIGNED
  VOID

  @@map("doc_status")
}

enum EquipKind {
  BATTERY
  COMBINER
  COLLAR
  GATEWAY

  @@map("equip_kind")
}

// NON-ADDITIVE: value rename RMA → RMA_OUT (D4).
enum EquipStatus {
  IN_STOCK
  ALLOCATED
  INSTALLED
  RMA_OUT
  RETIRED

  @@map("equip_status")
}

enum WoType {
  INSTALL
  SERVICE
  INSPECTION
  TURNOVER

  @@map("wo_type")
}

// NON-ADDITIVE: replaces WorkOrderStatus (AWARDED/IN_PROGRESS/SUBMITTED/ACCEPTED/REWORK).
enum WoStatus {
  DRAFT
  SCHEDULED
  CHECKED_IN
  COMPLETE
  CANCELLED

  @@map("wo_status")
}

// NON-ADDITIVE: replaces Severity (INFO/WARN/CRITICAL); remapped on migration.
enum AlertSeverity {
  WATCH
  FAULT

  @@map("alert_severity")
}

enum TicketState {
  NEW
  TRIAGED
  REMOTE_ATTEMPTED
  FIELD_NEEDED
  SCHEDULED
  ON_SITE
  RESOLVED
  VERIFIED
  CLOSED

  @@map("ticket_state")
}

enum TicketCategory {
  COMMS
  HARDWARE
  PERFORMANCE
  PHYSICAL
  RESIDENT

  @@map("ticket_category")
}

enum ResolutionCode {
  REMOTE_FIX
  HARDWARE_RMA
  WIRING
  RESIDENT_ACTION
  NO_FAULT

  @@map("resolution_code")
}

enum LedgerType {
  ENROLL_INC
  PERF_PAY
  ITC_CASH
  OPEX
  SERVICE_COST

  @@map("ledger_type")
}

enum LedgerStatus {
  EXPECTED
  RECEIVED
  VARIANCE

  @@map("ledger_status")
}

enum SeasonStatus {
  OPEN
  CLOSED
  RECONCILED

  @@map("season_status")
}

enum ClaimStatus {
  ACCRUING
  BASIS_LOCKED
  EVIDENCE_COMPLETE
  IN_COHORT
  TRANSFERRED

  @@map("claim_status")
}

enum CohortStatus {
  ASSEMBLING
  LISTED
  TERM_SHEET
  DILIGENCE
  EXECUTED
  CASH_RECEIVED

  @@map("cohort_status")
}

enum BasisSource {
  PO
  WO
  PERMIT
  OVERHEAD

  @@map("basis_source")
}

enum AllocCategory {
  CAT1
  CAT3

  @@map("alloc_category")
}

enum EventSource {
  ENERGYHUB_CSV
  ENLIGHTEN_XCHECK
  MANUAL

  @@map("event_source")
}

// NON-ADDITIVE: consolidates UserRole (ADMIN/OWNER) + PlatformRole (SALES_REP/…/HOMEOWNER).
enum Role {
  ADMIN
  OPS
  FIELD
  VIEWER

  @@map("role")
}

enum PoStatus {
  DRAFT
  ORDERED
  RECEIVED
  PARTIAL

  @@map("po_status")
}

// ==== SYSTEM TABLES: users + activity_log ====================================

/// Consolidated platform users (formerly `User` + `PlatformUser`). Identity for
/// admins is verified by Firebase; the API issues its own JWT. Firebase link kept (R6).
model User {
  id          Int      @id @default(autoincrement())
  firebaseUid String?  @unique @map("firebase_uid") @db.VarChar(128) // NON-ADDITIVE: relaxed to nullable (non-Firebase staff)
  email       String   @unique @db.VarChar(255)
  name        String?  @db.VarChar(255)
  role        Role     @default(ADMIN)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// Every mutation writes here (01 §Cross-cutting). Generic append-only audit log.
model ActivityLog {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity   String
  entityId String   @map("entity_id")
  action   String
  actor    String?
  at       DateTime @default(now())
  meta     Json?

  @@index([entity, entityId])
  @@map("activity_log")
}

// ==== THE ONE RECORD: systems ================================================

/// The lifecycle record — one row per unit. Everything orbits it (01 §systems).
model System {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId  String  @map("property_id")
  unitLabel   String? @map("unit_label")
  addressLine String? @map("address_line")
  residentId  String? @map("resident_id") @db.Uuid

  stage Stage @default(S01_LEAD)

  blockedCode String?   @map("blocked_code")
  blockedAt   DateTime? @map("blocked_at")
  blockedNote String?   @map("blocked_note")

  terminalState  TerminalState? @map("terminal_state")
  terminalReason String?        @map("terminal_reason")
  terminalAt     DateTime?      @map("terminal_at")

  health HealthState? // cache; alerts are truth. null pre-Live.
  flags  Flag[]       @default([])

  source            String?
  connectionMethod  Connection? @map("connection_method")
  tier              Tier?
  lockedRates       Json?       @map("locked_rates")
  currentSnapshotId String?     @map("current_snapshot_id") @db.Uuid

  kwRated  Decimal? @map("kw_rated")
  kwhRated Decimal? @map("kwh_rated")
  gridEdge Boolean? @map("grid_edge")

  rofDate      DateTime? @map("rof_date") @db.Date
  rofDeadline  DateTime? @map("rof_deadline") @db.Date
  installDate  DateTime? @map("install_date") @db.Date
  pisDate      DateTime? @map("pis_date") @db.Date
  cofDate      DateTime? @map("cof_date") @db.Date
  termEnd      DateTime? @map("term_end") @db.Date
  warrantyEnd  DateTime? @map("warranty_end") @db.Date
  recaptureEnd DateTime? @map("recapture_end") @db.Date

  // The five external identities X1–X5 (+ related identifiers).
  cgbAppNo        String? @map("cgb_app_no")
  edcAccountNo    String? @map("edc_account_no")
  edcAccountName  String? @map("edc_account_name")
  ixAppNo         String? @map("ix_app_no")
  enlightenSiteId String? @map("enlighten_site_id")
  gatewaySn       String? @map("gateway_sn")
  dermsId         String? @map("derms_id")
  permitNo        String? @map("permit_no")

  installerOfRecord Json?   @map("installer_of_record")
  gridProfile       String? @map("grid_profile")
  fwVersion         String? @map("fw_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  property       Property        @relation(fields: [propertyId], references: [id])
  resident       Resident?       @relation("SystemCurrentResident", fields: [residentId], references: [id])
  blockedCodeRef BlockedCode?    @relation(fields: [blockedCode], references: [code])
  residents      Resident[]      @relation("SystemResidents")
  qualSnapshots  QualSnapshot[]
  enrollments    Enrollment[]
  checklistItems ChecklistItem[]
  stageHistory   StageHistory[]
  documents      Document[]
  equipment      Equipment[]
  workOrders     WorkOrder[]
  alerts         Alert[]
  tickets        Ticket[]
  events         Event[]
  ledgerEntries  LedgerEntry[]
  itcClaim       ItcClaim?
  turnoverCases  TurnoverCase[]

  @@unique([propertyId, unitLabel])
  @@index([stage])
  @@index([propertyId])
  @@index([health])
  @@index([blockedCode])
  @@map("systems")
}

// ==== RELATIONSHIP LAYER =====================================================

model Account {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      AccountType
  name      String
  dealState DealState?  @map("deal_state")
  notes     String?
  createdAt DateTime    @default(now()) @map("created_at")

  contacts   AccountContact[]
  properties Property[]

  @@map("accounts")
}

model AccountContact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  name      String
  role      String? // ED / PM / board / owner
  phone     String?
  email     String?
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("account_contacts")
}

/// Migrated in place from `addresses` (id preserved). geo computed once, inherited by units.
model Property {
  id              String   @id @default(cuid())
  accountId       String?  @map("account_id") @db.Uuid
  name            String?
  address         String   @map("line1")
  town            String?  @map("city")
  state           String   @default("CT")
  postalCode      String   @map("postal_code")
  county          String
  lat             Float?
  lng             Float?
  masterAgmtDocId String?  @map("master_agmt_doc_id")
  geo             Json?
  // Legacy reference dimensions retained from `addresses` (frozen spine joins).
  utilityId       String?  @map("utility_id")
  ahjId           String?  @map("ahj_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  account          Account?    @relation(fields: [accountId], references: [id])
  masterAgmtDoc    Document?   @relation("PropertyMasterAgmt", fields: [masterAgmtDocId], references: [id])
  utility          Utility?    @relation(fields: [utilityId], references: [id])
  ahj              Ahj?        @relation(fields: [ahjId], references: [id])
  systems          System[]
  documents        Document[]
  // Frozen-spine back-relations (retained; no new writes).
  leads            SalesLead[] @relation("LeadAddress")
  serviceCustomers Customer[]  @relation("CustServiceAddr")
  billingCustomers Customer[]  @relation("CustBillingAddr")
  projects         Project[]   @relation("ProjSiteAddr")

  @@index([county])
  @@map("properties")
}

/// Occupancy history — one row per occupancy; never overwrite (01 §residents).
model Resident {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  systemId       String    @map("system_id") @db.Uuid
  name           String?
  edcAccountName String?   @map("edc_account_name")
  phone          String?
  email          String?
  since          DateTime? @db.Date
  until          DateTime? @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")

  system           System   @relation("SystemResidents", fields: [systemId], references: [id])
  currentOfSystems System[] @relation("SystemCurrentResident")

  @@index([systemId])
  @@map("residents")
}

// ==== LIFECYCLE LAYER ========================================================

model QualSnapshot {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  systemId          String   @map("system_id") @db.Uuid
  version           Int
  inputs            Json?
  tier              Tier?
  itcProfile        Json?    @map("itc_profile")
  revenueProjection Json?    @map("revenue_projection")
  runAt             DateTime @default(now()) @map("run_at")

  system System @relation(fields: [systemId], references: [id])

  @@index([systemId])
  @@map("qual_snapshots")
}

model Enrollment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  systemId      String    @map("system_id") @db.Uuid
  program       String    @default("ct_ess")
  appNo         String?   @map("app_no")
  submittedAt   DateTime? @map("submitted_at")
  rofDate       DateTime? @map("rof_date") @db.Date
  rofDeadline   DateTime? @map("rof_deadline") @db.Date
  cofDate       DateTime? @map("cof_date") @db.Date
  tier          Tier?
  rates         Json?
  status        String?
  deficiencyDue DateTime? @map("deficiency_due") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  system System @relation(fields: [systemId], references: [id])

  @@index([systemId])
  @@map("enrollments")
}

/// Seed table — the gates read from here (01 §Seed).
model ChecklistTemplate {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stage       Stage
  key         String
  label       String
  required    Boolean @default(true)
  conditional String? // predicate name or null
  autoOnly    Boolean @default(false) @map("auto_only")
  ownerRole   Role?   @map("owner_role")
  sort        Int     @default(0)

  @@unique([stage, key])
  @@map("checklist_templates")
}

model ChecklistItem {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  systemId  String         @map("system_id") @db.Uuid
  stage     Stage
  key       String
  label     String
  required  Boolean        @default(true)
  state     ChecklistState @default(OPEN)
  ownerRole Role?          @map("owner_role")
  docId     String?        @map("doc_id")
  doneAt    DateTime?      @map("done_at")
  doneBy    String?        @map("done_by")

  system System @relation(fields: [systemId], references: [id])

  @@unique([systemId, stage, key])
  @@index([systemId])
  @@map("checklist_items")
}

/// Append-only (01 §stage_history). Migrated in place from `stage_transitions`.
model StageHistory {
  id        String     @id @default(cuid())
  systemId  String     @map("system_id") @db.Uuid
  fromStage Stage?     @map("from_stage")
  toStage   Stage      @map("to_stage")
  at        DateTime   @default(now())
  by        String? // user id or 'system'
  via       HistoryVia @default(AUTO)

  system System @relation(fields: [systemId], references: [id])

  @@unique([systemId, fromStage, toStage])
  @@index([systemId])
  @@map("stage_history")
}

/// Migrated in place from `documents` (Document). Scope: system / property / account.
model Document {
  id         String       @id @default(cuid())
  systemId   String?      @map("system_id") @db.Uuid
  propertyId String?      @map("property_id")
  accountId  String?      @map("account_id") @db.Uuid
  type       DocumentType
  title      String?
  envelopeId String?      @map("envelope_id")
  status     DocStatus    @default(DRAFT)
  signedAt   DateTime?    @map("signed_at")
  fileKey    String?      @map("file_key")
  uploadedBy String?      @map("uploaded_by")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  system            System?     @relation(fields: [systemId], references: [id])
  property          Property?   @relation(fields: [propertyId], references: [id])
  masterAgmtOfProps Property[]  @relation("PropertyMasterAgmt")
  equipmentAttest   Equipment[] @relation("EquipAttestation")

  @@index([systemId])
  @@index([propertyId])
  @@map("documents")
}

// ==== FIELD & EQUIPMENT LAYER ================================================

/// Migrated in place from `contractors`. Marketplace/bid framing dropped.
model Installer {
  id          String   @id @default(cuid())
  orgName     String   @map("org_name")
  selfPerform Boolean  @default(false) @map("self_perform")
  licenseNos  Json?    @map("license_nos")
  rates       Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  crews Crew[]

  @@map("installers")
}

model Crew {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  installerId    String   @map("installer_id")
  label          String
  members        Json? // [{name, license}]
  capacityPerDay Int?     @map("capacity_per_day")
  createdAt      DateTime @default(now()) @map("created_at")

  installer  Installer   @relation(fields: [installerId], references: [id])
  workOrders WorkOrder[]

  @@index([installerId])
  @@map("crews")
}

/// Migrated in place from `work_orders` (WorkOrder). jobPostingId relaxed nullable (GAP §5.5).
model WorkOrder {
  id           String    @id @default(cuid())
  systemId     String?   @map("system_id") @db.Uuid
  type         WoType    @default(INSTALL)
  crewId       String?   @map("crew_id") @db.Uuid
  date         DateTime?
  routeGroup   String?   @map("route_group")
  status       WoStatus  @default(DRAFT)
  checklist    Json?
  photos       Json? // [{stage_key, file_key, gps, at}]
  checkinAt    DateTime? @map("checkin_at")
  checkoutAt   DateTime? @map("checkout_at")
  ticketId     String?   @map("ticket_id") @db.Uuid
  // Retained legacy marketplace link (relaxed nullable per GAP §5.5).
  jobPostingId String?   @unique @map("job_posting_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  system          System?     @relation(fields: [systemId], references: [id])
  crew            Crew?       @relation(fields: [crewId], references: [id])
  ticket          Ticket?     @relation("WorkOrderTicket", fields: [ticketId], references: [id])
  jobPosting      JobPosting? @relation(fields: [jobPostingId], references: [id])
  survey          SiteSurvey?
  ticketsResolved Ticket[]    @relation("TicketWorkOrder")

  @@index([systemId])
  @@map("work_orders")
}

/// Migrated in place from `battery_assets`. Stock + installed units, one table (D4).
model Equipment {
  id               String      @id @default(cuid())
  systemId         String?     @map("system_id") @db.Uuid
  kind             EquipKind   @default(BATTERY)
  serial           String      @unique
  sku              String?
  dom              Boolean?
  attestationDocId String?     @map("attestation_doc_id")
  fw               String?
  status           EquipStatus @default(IN_STOCK)
  installedAt      DateTime?   @map("installed_at")
  removedAt        DateTime?   @map("removed_at")
  replacedById     String?     @map("replaced_by_id")
  rmaNo            String?     @map("rma_no")
  poId             String?     @map("po_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  system         System?        @relation(fields: [systemId], references: [id])
  attestationDoc Document?      @relation("EquipAttestation", fields: [attestationDocId], references: [id])
  replacedBy     Equipment?     @relation("EquipLineage", fields: [replacedById], references: [id])
  replaces       Equipment[]    @relation("EquipLineage")
  po             PurchaseOrder? @relation(fields: [poId], references: [id])

  @@index([status])
  @@index([systemId])
  @@map("equipment")
}

// ==== OPERATING LAYER ========================================================

/// Migrated in place from `alerts` (Alert). Retargeted to system_id; severity remapped.
model Alert {
  id        String        @id @default(cuid())
  systemId  String        @map("system_id") @db.Uuid
  ruleKey   String?       @map("rule_key")
  severity  AlertSeverity @default(WATCH)
  openedAt  DateTime      @default(now()) @map("opened_at")
  clearedAt DateTime?     @map("cleared_at")
  context   Json?
  ticketId  String?       @map("ticket_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  system System     @relation(fields: [systemId], references: [id])
  rule   AlertRule? @relation(fields: [ruleKey], references: [key])
  ticket Ticket?    @relation(fields: [ticketId], references: [id])

  @@index([systemId])
  @@index([ruleKey])
  @@map("alerts")
}

model Ticket {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  systemId       String          @map("system_id") @db.Uuid
  category       TicketCategory
  source         String? // auto/resident/pm/field
  severity       AlertSeverity?
  state          TicketState     @default(NEW)
  linkedAlertId  String?         @map("linked_alert_id")
  linkedEventId  String?         @map("linked_event_id") @db.Uuid
  remoteLog      Json[]          @default([]) @map("remote_log")
  workOrderId    String?         @map("work_order_id")
  warrantyFlag   Boolean         @default(false) @map("warranty_flag")
  rma            Json?
  resolutionCode ResolutionCode? @map("resolution_code")
  resolvedAt     DateTime?       @map("resolved_at")
  verifiedAt     DateTime?       @map("verified_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  system             System      @relation(fields: [systemId], references: [id])
  workOrder          WorkOrder?  @relation("TicketWorkOrder", fields: [workOrderId], references: [id])
  linkedEvent        Event?      @relation(fields: [linkedEventId], references: [id])
  alerts             Alert[]
  workOrdersAssigned WorkOrder[] @relation("WorkOrderTicket")

  @@index([systemId])
  @@map("tickets")
}

model Season {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String // SUMMER / WINTER
  programYear Int          @map("program_year")
  window      Json? // daterange {start, end}
  status      SeasonStatus @default(OPEN)

  events        Event[]
  ledgerEntries LedgerEntry[]

  @@map("seasons")
}

model Event {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  systemId    String       @map("system_id") @db.Uuid
  seasonId    String?      @map("season_id") @db.Uuid
  date        DateTime     @db.Date
  window      String?
  kwNominated Decimal?     @map("kw_nominated")
  kwDelivered Decimal?     @map("kw_delivered")
  ratio       Decimal?
  socStart    Decimal?     @map("soc_start")
  online      Boolean?
  source      EventSource?

  system  System   @relation(fields: [systemId], references: [id])
  season  Season?  @relation(fields: [seasonId], references: [id])
  tickets Ticket[]

