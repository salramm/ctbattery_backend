# Copy to .env for local dev. Never commit the real .env.
NODE_ENV=development
PORT=3000

# Local Postgres (see docker note in CLAUDE.md / deployment/)
DATABASE_URL=postgresql://ctbs:ctbs@localhost:5432/ct_battery_solutions

# Auth
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# Firebase Admin — full service-account JSON on ONE line (not a file path)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

# CORS / frontend
FRONTEND_URL=http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# DigitalOcean Spaces (S3-compatible file storage). Leave blank to disable uploads.
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_CDN_ENDPOINT=

LOG_LEVEL=info
